# Copy this file to .env and fill in your values.
# .env is ignored by git, so your keys stay on your machine.
# On GitHub, set the same names as repository secrets instead.


# Supabase – the fetcher writes jobs here when both are set (otherwise web/public/jobs.json).
# Project Settings → API Keys. The service_role / secret key can write: never share or commit it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
