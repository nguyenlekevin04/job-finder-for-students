# Copy to web/.env.local to load jobs from Supabase in `npm run dev` / `npm run build`.
# Without these the site reads web/public/jobs.json (run `python fetcher/main.py` first).
# Both values are public: the anon / publishable key can only read.
# Use the STAGING project here; production values belong only in Vercel's Production environment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set to "staging" to show the staging banner and hide the site from search engines.
NEXT_PUBLIC_DEPLOY_ENV=

# Imprint / privacy operator (public on the site, but kept out of the repo).
# Set in Vercel per environment; without them the pages show placeholders.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_STREET=
NEXT_PUBLIC_OPERATOR_CITY=
NEXT_PUBLIC_OPERATOR_EMAIL=

# Cookieless usage counts (Umami Cloud, free Hobby plan). Set only in Vercel's Production
# environment, so staging and local builds send nothing. Public: the id is in every page.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
