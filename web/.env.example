# Copy to web/.env.local to load jobs from Supabase in `npm run dev` / `npm run build`.
# Without these the site reads web/public/jobs.json (run `python fetcher/main.py` first).
# Both values are public: the anon / publishable key can only read.
# Use the STAGING project here; production values belong only in Render's production site.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set to "staging" to show the staging banner and hide the site from search engines.
NEXT_PUBLIC_DEPLOY_ENV=
